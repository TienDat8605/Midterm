                        <ui:VisualElement class="diamond-icon" style="background-color: rgb(205, 120, 50);"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="info-row map-selection-row" style="width: 168px;">
                        <ui:Button text="" name="PreviousMapButton" class="arrow-button-brown" style="height: 42px; width: 41px; background-image: url(&quot;project://database/Assets/Sprites/UI/Sprite%20sheet%20for%20Basic%20Pack.png?fileID=-4314349355719926730&amp;guid=f24abd975bb0c9d468f1c9fa23dcdd8e&amp;type=3#Sprite sheet for Basic Pack_29&quot;); background-color: rgba(255, 255, 255, 0); opacity: 1; border-left-color: rgba(43, 28, 16, 0); border-right-color: rgba(43, 28, 16, 0); border-top-color: rgba(43, 28, 16, 0); border-bottom-color: rgba(43, 28, 16, 0); top: 16px;"/>
                        <ui:VisualElement class="info-text-col">
