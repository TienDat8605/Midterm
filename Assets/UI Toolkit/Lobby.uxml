<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Lobby.uss?fileID=7433441132597879392&amp;guid=2c31384ed16fb504d95205766c3bce37&amp;type=3#Lobby"/>
    <ui:VisualElement name="Root" class="root-canvas">
        <ui:VisualElement name="TopBar" class="top-bar">
            <ui:VisualElement class="top-box title-box" style="height: 99px; width: 432px; position: absolute; top: 33px; left: 727px;">
                <ui:VisualElement class="cat-icon-yellow" style="background-image: url(&quot;project://database/Assets/Sprites/UI/Sprite%20sheet%20for%20Basic%20Pack.png?fileID=-3765290273801814435&amp;guid=f24abd975bb0c9d468f1c9fa23dcdd8e&amp;type=3#Sprite sheet for Basic Pack_167&quot;); height: 60px; width: 62px;"/>
                <ui:Label text="LOBBY" name="LobbyTitle" class="lobby-title"/>
