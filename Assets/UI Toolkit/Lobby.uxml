                            <ui:Label text="MAP 1" name="MapLabel" class="value-text-green" style="color: rgb(255, 255, 255); font-size: 21px; width: 46px; -unity-text-align: upper-center;"/>
                        </ui:VisualElement>
                        <ui:Button text="" name="NextMapButton" class="arrow-button-brown" style="height: 45px; width: 42px; background-image: url(&quot;project://database/Assets/Sprites/UI/Sprite%20sheet%20for%20Basic%20Pack.png?fileID=-4104028942534283489&amp;guid=f24abd975bb0c9d468f1c9fa23dcdd8e&amp;type=3#Sprite sheet for Basic Pack_7&quot;); background-color: rgba(180, 130, 80, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; top: 15px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="RoomInfoSpacer" class="info-row">
                        <ui:VisualElement class="info-text-col"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="MaxPlayersRow" class="info-row max-players-row">
